<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Skala typografii. Pięć rozmiarów, nie dziesięć: telefon leży na podłodze, a gracze
        patrzą z dwóch metrów, więc liczy się wyraźna różnica między poziomami, a nie ich
        liczba. Rozmiary są w jednostkach niezależnych od gęstości, więc systemowe
        powiększenie czcionki nadal działa.
    -->
    <x:Double x:Key="FontSizeDisplay">64</x:Double>
    <x:Double x:Key="FontSizeHeadline">34</x:Double>
    <x:Double x:Key="FontSizeTitle">22</x:Double>
    <x:Double x:Key="FontSizeBody">16</x:Double>
    <x:Double x:Key="FontSizeCaption">13</x:Double>

    <!-- Odstępy: jedna skala 4/8/16/24/32 dla całej aplikacji. -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <!--
        Wysokości miejsc zarezerwowanych na ekranie rozgrywki. Wydarzenie, odliczanie i stan
        mikrofonu pojawiają się i znikają w trakcie tury — gdyby zabierały ze sobą swoje
        miejsce, cała reszta ekranu skakałaby w górę i w dół pod palcem gracza.
        <para>
        Wartości są <b>policzone, nie dobrane na oko</b>: cały ekran rozgrywki ma się zmieścić
        na telefonie bez przewijania (około 750 jednostek wysokości na typowym urządzeniu),
        więc każde zarezerwowane miejsce jest tak niskie, jak pozwala treść w środku —
        wydarzenie na dwa wiersze pisma podstawowego, odliczanie na liczbę 44 z podpisem,
        stan mikrofonu na jedną linię podpisu.
        </para>
    -->
    <x:Double x:Key="EventSlotHeight">56</x:Double>
    <x:Double x:Key="CountdownSlotHeight">70</x:Double>
    <x:Double x:Key="VoiceSlotHeight">20</x:Double>

    <!--
        Wysokość banera reklamowego. Pięćdziesiąt jednostek, bo tyle ma baner standardowy
        (320×50) — rozmiar stały, zgodnie z ustaleniem z użytkownikiem. Baner adaptacyjny
        dopasowałby wysokość do urządzenia, ale wtedy zarezerwowane miejsce zależałoby od
        telefonu, a ten ekran jest policzony co do jednostki.
    -->
    <x:Double x:Key="BannerSlotHeight">50</x:Double>

    <!--
        Skład partii na ekranie rozgrywki: wiersz „pigułek", nie lista kart. Karta na gracza
        zajmowała 72 jednostki i przy czterech osobach spychała przyciski poza ekran, a wiersz
        pigułek mieści cały skład w jednej linii. Cała pigułka jest celem dotknięcia, więc
        zgłoszenie upadku nie potrzebuje osobnego, małego przycisku.
    -->
    <x:Double x:Key="PlayerChipRowHeight">40</x:Double>

    <!--
        Pigułka gracza. Obniżona z 44 na 34 jednostki po uwadze z urządzenia: skład jest na
        ekranie rozgrywki informacją drugorzędną — patrzy się na niego przy upadku, nie co
        turę — a zabierał tyle wysokości, ile rząd przycisków. Poniżej minimum dotykowego
        (48) schodzimy tu świadomie: cel dotknięcia jest szeroki, bo obejmuje całe imię ze
        znakiem, a nie kilkumilimetrowy przycisk, i nie stoi obok niczego, w co dałoby się
        trafić przez pomyłkę.
    -->
    <Style x:Key="PlayerChip" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinimumHeightRequest" Value="34" />
        <Setter Property="StrokeShape" Value="RoundRectangle 17" />
    </Style>

    <Thickness x:Key="PagePadding">24</Thickness>
    <x:Double x:Key="CornerRadiusCard">16</x:Double>

    <!--
        Minimalny cel dotknięcia: 48 jednostek. Wartość z wytycznych dostępności, nie
        z upodobania — palec na leżącym na podłodze telefonie trafia gorzej niż palec
        w trzymanym.
    -->
    <x:Double x:Key="TouchTargetMin">48</x:Double>

    <!--
        Dwie wysokości przycisków wyższych od minimum dotykowego: akcja główna ekranu
        („Dalej", „Rozpocznij grę") i wiersz menu na ekranie startowym.

        Obniżone z 64 i 60 po sprawdzeniu na mniejszych telefonach — tam sześć takich wierszy
        pod sobą zabierało zbyt dużą część widoku. Zapas nad minimum dotykowym zostaje, bo te
        przyciski są używane w niewygodnych pozycjach, ale osiem jednostek na przycisk to na
        ekranie startowym prawie pięćdziesiąt jednostek odzyskane.

        To są <b>minimalne</b> wysokości, nie sztywne: przy powiększonej czcionce systemowej
        przycisk nadal urośnie tyle, ile potrzebuje jego napis.
    -->
    <x:Double x:Key="PrimaryActionHeight">56</x:Double>
    <x:Double x:Key="MenuRowHeight">52</x:Double>

    <Style x:Key="DisplayLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <!-- Nagłówek sekcji: tytuł plus odstęp nad nim, powtarzany na każdym ekranie. -->
    <Style x:Key="SectionHeaderLabel" TargetType="Label" BasedOn="{StaticResource TitleLabel}">
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <!--
        Karta: tło, zaokrąglenie i obrys. Osobno od zawartości, żeby lista graczy, lista
        trybów i lista wydarzeń wyglądały tak samo bez powtarzania czterech właściwości.
    -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>

    <!--
        Akcja główna ekranu: jedna, kolorowa, wyższa od reszty. Reszta przycisków jest
        grafitowa, więc ta jedna nie musi krzyczeć rozmiarem — wystarcza jej kolor i te kilka
        jednostek wysokości ponad sąsiadów.
    -->
    <Style x:Key="PrimaryActionButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource AccentActionText}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentAction}, Dark={StaticResource AccentActionDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource PrimaryActionHeight}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Przycisk drugoplanowy: wypełnienie jak w karcie, obrys w kolorze krawędzi. Nie jest
        przezroczysty i to jest poprawka po uwadze z urządzenia — przezroczysty przycisk zlewał
        się z tłem strony i wyglądał na wyłączony. Tło karty odróżnia go od tła, a brak koloru
        wciąż mówi, że to nie jest akcja główna.
    -->
    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Akcja wyróżniona wewnątrz karty albo wiersza („Użyj", „Dodaj", „Nowa paczka").
        Kolor ten sam co w akcji głównej ekranu, ale wysokość zwykłego przycisku — karta
        z przyciskiem wysokim jak akcja główna przestaje być kartą.
    -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource AccentActionText}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentAction}, Dark={StaticResource AccentActionDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Akcja niszcząca: „Usuń", „Zakończ grę". Obrys i napis w czerwieni, bez wypełnienia —
        ma odróżniać się od sąsiadów, ale nie zapraszać do naciśnięcia jako pierwsza.
    -->
    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Przycisk z obrysem w kolorze wypełnienia przycisku zwykłego. Trzeci stopień wagi
        w rzędzie sterowania partią: „Pauza" jest wypełniona grafitem, „Powtórz" ma sam obrys
        krawędzi, a „Zakończ" obrys grafitowy — widać, że to nie to samo co powtórzenie
        komunikatu, ale też nie akcja niszcząca w czerwieni.
    -->
    <Style x:Key="OutlinedPrimaryButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="BorderWidth" Value="2" />
    </Style>

    <!--
        Wiersz menu na ekranie startowym. Wygląda jak karta, a nie jak przycisk z obrysem:
        cztery jednakowe obrysy pod sobą czytały się jak formularz, a to jest menu.
    -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MenuRowHeight}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Przycisk paska górnego: strzałka powrotu w lewym górnym rogu. Bez tła i obrysu,
        bo na pasku nawigacji sam znak wystarcza — tak wygląda powrót w każdej aplikacji
        na tym systemie, a znajomy wzorzec nie potrzebuje wyróżnienia.
    -->
    <Style x:Key="AppBarButton" TargetType="Button">
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="WidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
    </Style>

    <!--
        Ramka pola wyboru i pola tekstowego. Domyślny <c>Picker</c> na Androidzie to sam
        napis z cienką linią pod spodem — nie widać po nim, że da się go nacisnąć. Ramka
        z tłem karty i znakiem „▾" mówi to, czego brakowało.
    -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!--
        Karta na liście z zaznaczeniem. Stany <c>Normal</c> i <c>Selected</c> są tu podane
        wprost, bo bez nich listę podświetla systemowy kolor zaznaczenia Androida —
        pomarańczowy, wzięty spoza palety aplikacji.
    -->
    <!--
        Przycisk ze znakiem, który <b>coś zmienia</b>: przeniesienie gracza w kolejce,
        zatwierdzenie nowego imienia. Wypełniony, nie szary — czynny przycisk w tym samym
        odcieniu co wyłączony to informacja nieprawdziwa, a przy strzałkach kolejności
        jedyna, jaką ma gracz.
    -->
    <Style x:Key="PrimaryIconButton" TargetType="Button">
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource OutlineDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Przycisk ze znakiem w kolorze akcji: dodanie wydarzenia do paczki. -->
    <Style x:Key="AccentIconButton" TargetType="Button" BasedOn="{StaticResource PrimaryIconButton}">
        <Setter Property="TextColor" Value="{StaticResource AccentActionText}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentAction}, Dark={StaticResource AccentActionDark}}" />
    </Style>

    <!--
        Przycisk z samym znakiem, bez podpisu. Znak musi być czytelny bez legendy, dlatego
        używamy powszechnie rozumianych symboli, a nazwę akcji podajemy przez
        <c>SemanticProperties.Description</c> — czytnik ekranu nadal powie, co robi przycisk.
    -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"/>
        <Setter Property="SelectedIndicatorColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}"/>
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTargetMin}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--
        Przyciski „+" i „−" zmieniające szansę wydarzenia o 5 punktów procentowych.
        Domyślny styl przycisku ma wypełnienie 14,10 i minimalną szerokość 44 — trzy takie
        przyciski w jednym wierszu wypchnęłyby „Dodaj wydarzenie" za krawędź ekranu.
        Styl nadaje im kwadratowy, ciasny kształt; wysokość zostaje na 40, żeby palec
        nadal trafiał w cel. Styl z kluczem nie dziedziczy stylu domyślnego, dlatego
        powtarza kolory i stany.
    -->
    <!--
        Przycisk ze znakiem, który usuwa albo wyklucza: kosz w składzie, odpadnięcie gracza.
